# Application
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# Database
DATABASE_PATH=./data/sms_gateway.db

# Modem (Huawei/ZTE USB dongle default gateway)
