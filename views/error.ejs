<!DOCTYPE html>
<html lang="sr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Greška — SMS Gateway</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <% if (user) { %>
  <header>
    <div class="brand">SMS Gateway</div>
    <nav>
      <a href="/panel">Panel</a>
      <form action="/panel/logout" method="POST" style="display:inline">
        <button type="submit" class="btn btn-secondary btn-sm">Odjava</button>
      </form>
    </nav>
  </header>
  <% } %>

  <div class="container">
    <div class="card" style="max-width:500px; margin-top:3rem;">
      <h1>Greška</h1>
      <div class="alert alert-error"><%= message %></div>
      <a href="/panel" class="btn btn-secondary">Nazad</a>
    </div>
  </div>
</body>
</html>
